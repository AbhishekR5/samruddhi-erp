<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_property_rent_payment_wizard_form" model="ir.ui.view">
            <field name="name">property.rent.payment.wizard.form</field>
            <field name="model">property.rent.payment.wizard</field>
            <field name="arch" type="xml">
                <form string="Register / Update Rent Payment">
                    <div class="alert alert-info d-flex justify-content-between align-items-center mb-3 p-3 rounded shadow-sm" role="status">
                        <div>
                            <div class="small text-muted fw-bold text-uppercase">Schedule Reference</div>
                            <div class="h5 mb-0 fw-bold"><field name="schedule_id" readonly="1" options="{'no_open': True}"/></div>
                        </div>
                        <div class="d-flex gap-3 text-end">
                            <div>
                                <div class="small text-muted">Total Due</div>
                                <div class="fw-bold"><field name="total_amount" widget="monetary"/></div>
                            </div>
                            <div>
                                <div class="small text-muted">Currently Paid</div>
                                <div class="fw-bold text-success"><field name="already_paid" widget="monetary"/></div>
                            </div>
                            <div class="ps-3 border-start">
                                <div class="small text-muted fw-bold">Remaining Balance</div>
                                <div class="h5 mb-0 fw-bold text-danger"><field name="remaining_balance" widget="monetary"/></div>
                            </div>
                        </div>
                    </div>

                    <group>
                        <group string="Payment Details">
                            <field name="payment_mode" widget="radio"/>
                            <field name="payment_amount" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Transaction Information">
                            <field name="payment_date"/>
                            <field name="payment_method"/>
                            <field name="payment_reference" placeholder="e.g. UTR123456 / Cheque #004521"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="note" nolabel="1" placeholder="Optional internal notes about this payment..."/>
                    </group>

                    <footer>
                        <button name="action_confirm_payment" string="Record Payment &amp; Update Status" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
