<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_move_form_rent_schedule_smart_button" model="ir.ui.view">
            <field name="name">account.move.form.rent.schedule.smart.button</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <!-- Add Rent Installment Smart Button in Button Box -->
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_rent_schedules"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-calendar"
                            invisible="rent_schedule_count == 0">
                        <field name="rent_schedule_count" widget="statinfo" string="Rent Installment"/>
                    </button>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
