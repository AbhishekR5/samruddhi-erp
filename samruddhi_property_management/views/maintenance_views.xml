<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Maintenance List View -->
        <record id="view_maintenance_request_tree" model="ir.ui.view">
            <field name="name">property.maintenance.request.list</field>
            <field name="model">property.maintenance.request</field>
            <field name="arch" type="xml">
                <list string="Maintenance Requests" decoration-danger="priority == '3'" decoration-warning="priority == '2'" decoration-success="state == 'completed'" decoration-muted="state == 'cancelled'">
                    <field name="name"/>
                    <field name="title"/>
                    <field name="property_id"/>
                    <field name="unit_id"/>
                    <field name="tenant_id" optional="show"/>
                    <field name="priority" widget="priority"/>
                    <field name="request_date"/>
                    <field name="assigned_user_id" widget="many2one_avatar_user"/>
                    <field name="vendor_id" optional="show"/>
                    <field name="actual_cost" widget="monetary" sum="Total Maintenance Cost"/>
                    <field name="state" widget="badge"/>
                    <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                    <field name="currency_id" column_invisible="True"/>
                </list>
            </field>
        </record>

        <!-- Maintenance Form View -->
        <record id="view_maintenance_request_form" model="ir.ui.view">
            <field name="name">property.maintenance.request.form</field>
            <field name="model">property.maintenance.request</field>
            <field name="arch" type="xml">
                <form string="Maintenance Request">
                    <header>
                        <button name="action_assign" type="object" string="Mark Assigned" class="btn-secondary" invisible="state != 'new'"/>
                        <button name="action_start" type="object" string="Start Work" class="btn-primary" invisible="state not in ('new', 'assigned', 'waiting')"/>
                        <button name="action_wait" type="object" string="Wait on Parts/Vendor" class="btn-light" invisible="state != 'in_progress'"/>
                        <button name="action_complete" type="object" string="Complete Ticket" class="btn-success" invisible="state not in ('in_progress', 'waiting')"/>
                        <button name="action_cancel" type="object" string="Cancel Ticket" class="btn-danger" invisible="state in ('completed', 'cancelled')"/>
                        <field name="state" widget="statusbar" statusbar_visible="new,assigned,in_progress,completed"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="title" class="oe_edit_only" string="Issue Summary"/>
                            <h1>
                                <field name="title" placeholder="e.g. Water leak in kitchen / AC compressor fault"/>
                            </h1>
                            <h3>
                                <field name="name" readonly="1" class="text-muted"/>
                            </h3>
                        </div>

                        <group>
                            <group string="Location &amp; Tenant">
                                <field name="property_id"/>
                                <field name="unit_id"/>
                                <field name="tenant_id"/>
                                <field name="contract_id" readonly="1"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                            <group string="Assignment &amp; Urgency">
                                <field name="priority" widget="priority"/>
                                <field name="request_date"/>
                                <field name="assigned_user_id"/>
                                <field name="vendor_id"/>
                                <field name="completion_date" readonly="1" invisible="not completion_date"/>
                            </group>
                        </group>

                        <group string="Cost Allocation">
                            <group>
                                <field name="estimated_cost" widget="monetary"/>
                                <field name="actual_cost" widget="monetary"/>
                            </group>
                            <group>
                                <field name="expense_id" readonly="1" invisible="not expense_id"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Detailed Problem &amp; Work Report" name="description">
                                <field name="description" placeholder="Document symptoms, diagnostic notes, technician observations..."/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Maintenance Kanban View -->
        <record id="view_maintenance_request_kanban" model="ir.ui.view">
            <field name="name">property.maintenance.request.kanban</field>
            <field name="model">property.maintenance.request</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state" class="o_kanban_small_column">
                    <field name="name"/>
                    <field name="title"/>
                    <field name="property_id"/>
                    <field name="unit_id"/>
                    <field name="priority"/>
                    <field name="assigned_user_id"/>
                    <field name="actual_cost"/>
                    <templates>
                        <t t-name="card">
                            <div class="d-flex justify-content-between align-items-center">
                                <strong class="fs-6 text-dark"><field name="title"/></strong>
                                <field name="priority" widget="priority"/>
                            </div>
                            <div class="small text-muted mt-1">
                                <field name="name"/> | <field name="property_id"/> (<field name="unit_id"/>)
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                                <field name="assigned_user_id" widget="many2one_avatar_user"/>
                                <span class="fw-bold text-primary"><field name="actual_cost" widget="monetary"/></span>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_maintenance_request_search" model="ir.ui.view">
            <field name="name">property.maintenance.request.search</field>
            <field name="model">property.maintenance.request</field>
            <field name="arch" type="xml">
                <search string="Search Maintenance Requests">
                    <field name="title"/>
                    <field name="name"/>
                    <field name="property_id"/>
                    <field name="unit_id"/>
                    <field name="assigned_user_id"/>
                    <filter string="Open Tickets" name="open" domain="[('state', 'in', ['new', 'assigned', 'in_progress', 'waiting'])]"/>
                    <filter string="High / Urgent Priority" name="urgent" domain="[('priority', 'in', ['2', '3'])]"/>
                    <filter string="My Assigned Tickets" name="my_tickets" domain="[('assigned_user_id', '=', uid)]"/>
                    <separator/>
                    <separator/>
                    <filter string="Property" name="group_property" domain="[]" context="{'group_by': 'property_id'}"/>
                    <filter string="Assigned Officer" name="group_user" domain="[]" context="{'group_by': 'assigned_user_id'}"/>
                    <filter string="Priority" name="group_priority" domain="[]" context="{'group_by': 'priority'}"/>
                    <filter string="Status" name="group_state" domain="[]" context="{'group_by': 'state'}"/>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_maintenance_request" model="ir.actions.act_window">
            <field name="name">Maintenance Requests</field>
            <field name="res_model">property.maintenance.request</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="search_view_id" ref="view_maintenance_request_search"/>
            <field name="context">{'search_default_open': 1}</field>
        </record>

        <!-- Menu items -->
        <menuitem id="menu_property_maintenance_requests"
                  name="Maintenance Tickets"
                  parent="menu_property_maintenance_parent"
                  action="action_maintenance_request"
                  sequence="10"/>
    </data>
</odoo>
