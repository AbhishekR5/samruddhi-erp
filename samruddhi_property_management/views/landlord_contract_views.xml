<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Landlord Contract List View -->
        <record id="view_landlord_contract_tree" model="ir.ui.view">
            <field name="name">property.landlord.contract.list</field>
            <field name="model">property.landlord.contract</field>
            <field name="arch" type="xml">
                <list string="Landlord Contracts" decoration-success="state == 'active'" decoration-warning="state == 'expiring'" decoration-muted="state in ('expired', 'cancelled')" decoration-danger="state == 'terminated'">
                    <field name="name"/>
                    <field name="contract_number"/>
                    <field name="landlord_id"/>
                    <field name="property_id"/>
                    <field name="contract_type" widget="badge"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="monthly_amount" widget="monetary"/>
                    <field name="payment_frequency"/>
                    <field name="total_payable_balance" widget="monetary"/>
                    <field name="state" widget="badge"/>
                    <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                    <field name="currency_id" column_invisible="True"/>
                </list>
            </field>
        </record>

        <!-- Landlord Contract Form View -->
        <record id="view_landlord_contract_form" model="ir.ui.view">
            <field name="name">property.landlord.contract.form</field>
            <field name="model">property.landlord.contract</field>
            <field name="arch" type="xml">
                <form string="Landlord Contract">
                    <header>
                        <button name="action_activate" type="object" string="Activate Contract" class="btn-primary" invisible="state != 'draft'"/>
                        <button name="action_generate_payment_schedules" type="object" string="Generate Payment Schedule" class="btn-secondary" invisible="state not in ('draft', 'active')"/>
                        <button name="action_terminate" type="object" string="Terminate" class="btn-warning" invisible="state not in ('active', 'expiring')"/>
                        <button name="action_cancel" type="object" string="Cancel" class="btn-danger" invisible="state not in ('draft', 'active')"/>
                        <button name="action_draft" type="object" string="Reset to Draft" class="btn-light" invisible="state not in ('cancelled', 'terminated')"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,active,expiring,expired"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_payments" type="object" class="oe_stat_button" icon="fa-money">
                                <field name="payment_count" widget="statinfo" string="Payout Dues"/>
                            </button>
                        </div>

                        <div class="oe_title">
                            <label for="name" class="oe_edit_only" string="Contract Identifier"/>
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                            <h3>
                                <field name="contract_number" placeholder="Legal / Registration Number"/>
                            </h3>
                        </div>

                        <group>
                            <group string="Parties &amp; Scope">
                                <field name="landlord_id"/>
                                <field name="property_id"/>
                                <field name="unit_id"/>
                                <field name="contract_type"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                            <group string="Commercial Terms">
                                <field name="start_date"/>
                                <field name="end_date"/>
                                <field name="monthly_amount" widget="monetary"/>
                                <field name="security_deposit" widget="monetary"/>
                                <field name="payment_frequency"/>
                                <field name="payment_due_day"/>
                            </group>
                        </group>

                        <group string="Escalation &amp; Conditions">
                            <group>
                                <field name="notice_period"/>
                                <field name="rent_escalation"/>
                            </group>
                            <group>
                                <field name="total_disbursed" widget="monetary"/>
                                <field name="total_payable_balance" widget="monetary"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Payment Schedules" name="payments">
                                <field name="payment_ids" readonly="1">
                                    <list string="Landlord Payment Schedule" decoration-success="state == 'paid'" decoration-danger="state == 'overdue'" decoration-warning="state == 'partial'">
                                        <field name="name"/>
                                        <field name="period_start"/>
                                        <field name="period_end"/>
                                        <field name="due_date"/>
                                        <field name="amount" widget="monetary"/>
                                        <field name="paid_amount" widget="monetary"/>
                                        <field name="balance_amount" widget="monetary"/>
                                        <field name="payment_date"/>
                                        <field name="state" widget="badge"/>
                                        <field name="move_id" optional="show"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Renewal &amp; Special Terms" name="terms">
                                <field name="renewal_terms" placeholder="Terms for renewal, maintenance liabilities, tax deductions (TDS)..."/>
                            </page>
                            <page string="Contract Documents" name="documents">
                                <field name="document_ids" widget="many2many_binary"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_landlord_contract_search" model="ir.ui.view">
            <field name="name">property.landlord.contract.search</field>
            <field name="model">property.landlord.contract</field>
            <field name="arch" type="xml">
                <search string="Search Landlord Contracts">
                    <field name="name" string="Contract" filter_domain="['|', ('name', 'ilike', self), ('contract_number', 'ilike', self)]"/>
                    <field name="landlord_id"/>
                    <field name="property_id"/>
                    <filter string="Active Contracts" name="active" domain="[('state', '=', 'active')]"/>
                    <filter string="Expiring Soon" name="expiring" domain="[('state', '=', 'expiring')]"/>
                    <filter string="Expired" name="expired" domain="[('state', '=', 'expired')]"/>
                    <separator/>
                    <filter string="Rent Contracts" name="rent" domain="[('contract_type', '=', 'rent')]"/>
                    <separator/>
                    <filter string="Landlord" name="group_landlord" domain="[]" context="{'group_by': 'landlord_id'}"/>
                    <filter string="Property" name="group_property" domain="[]" context="{'group_by': 'property_id'}"/>
                    <filter string="Status" name="group_state" domain="[]" context="{'group_by': 'state'}"/>
                    <filter string="Contract Type" name="group_type" domain="[]" context="{'group_by': 'contract_type'}"/>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_landlord_contract" model="ir.actions.act_window">
            <field name="name">Landlord Contracts</field>
            <field name="res_model">property.landlord.contract</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_landlord_contract_search"/>
        </record>

        <!-- Menu items -->
        <menuitem id="menu_property_landlord_contracts"
                  name="Landlord Contracts"
                  parent="menu_property_landlords_parent"
                  action="action_landlord_contract"
                  sequence="20"/>

        <menuitem id="menu_property_all_landlord_contracts"
                  name="Landlord Agreements"
                  parent="menu_property_contracts_parent"
                  action="action_landlord_contract"
                  sequence="10"/>
    </data>
</odoo>
