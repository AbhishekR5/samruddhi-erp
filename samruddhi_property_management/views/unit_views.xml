<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Unit List View -->
        <record id="view_property_unit_tree" model="ir.ui.view">
            <field name="name">property.unit.list</field>
            <field name="model">property.unit</field>
            <field name="arch" type="xml">
                <list string="Rentable Units" decoration-success="status == 'available'" decoration-info="status == 'occupied'" decoration-warning="status == 'maintenance'" decoration-danger="status == 'reserved'">
                    <field name="unit_code"/>
                    <field name="name"/>
                    <field name="property_id"/>
                    <field name="floor"/>
                    <field name="unit_type"/>
                    <field name="area"/>
                    <field name="bedrooms"/>
                    <field name="bathrooms"/>
                    <field name="furnishing"/>
                    <field name="market_rent" widget="monetary"/>
                    <field name="current_tenant_id" optional="show"/>
                    <field name="status" widget="badge"/>
                    <field name="currency_id" column_invisible="True"/>
                </list>
            </field>
        </record>

        <!-- Unit Form View -->
        <record id="view_property_unit_form" model="ir.ui.view">
            <field name="name">property.unit.form</field>
            <field name="model">property.unit</field>
            <field name="arch" type="xml">
                <form string="Rentable Unit">
                    <header>
                        <button name="action_set_available" type="object" string="Set Available" class="btn-primary" invisible="status == 'available'"/>
                        <button name="action_set_maintenance" type="object" string="Set Maintenance" class="btn-secondary" invisible="status == 'maintenance'"/>
                        <field name="status" widget="statusbar" statusbar_visible="available,reserved,occupied,maintenance,inactive"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_tenant_contracts" type="object" class="oe_stat_button" icon="fa-file-text-o">
                                <span class="o_stat_text">Tenant Contracts</span>
                            </button>
                        </div>

                        <div class="oe_title">
                            <label for="name" class="oe_edit_only" string="Unit Identifier / Name"/>
                            <h1>
                                <field name="name" placeholder="e.g. Unit 101 / Suite B"/>
                            </h1>
                            <h3>
                                <field name="unit_code" readonly="1" class="text-muted"/>
                            </h3>
                        </div>

                        <group>
                            <group string="Property &amp; Placement">
                                <field name="property_id"/>
                                <field name="floor"/>
                                <field name="unit_type"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                            <group string="Unit Specifications">
                                <field name="area"/>
                                <field name="bedrooms"/>
                                <field name="bathrooms"/>
                                <field name="furnishing"/>
                                <field name="market_rent" widget="monetary"/>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                        </group>

                        <group string="Current Occupancy" invisible="not current_tenant_id">
                            <group>
                                <field name="current_tenant_id" readonly="1"/>
                                <field name="active_contract_id" readonly="1"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Amenities &amp; Description" name="description">
                                <field name="description" placeholder="List specifications, floor plans, fixture inventories, power backup..."/>
                            </page>
                            <page string="Contract History" name="contracts">
                                <field name="tenant_contract_ids" readonly="1">
                                    <list string="Tenant Contracts">
                                        <field name="name"/>
                                        <field name="tenant_id"/>
                                        <field name="start_date"/>
                                        <field name="end_date"/>
                                        <field name="monthly_rent"/>
                                        <field name="state" widget="badge"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Unit Kanban View -->
        <record id="view_property_unit_kanban" model="ir.ui.view">
            <field name="name">property.unit.kanban</field>
            <field name="model">property.unit</field>
            <field name="arch" type="xml">
                <kanban default_group_by="status" class="o_kanban_small_column">
                    <field name="name"/>
                    <field name="unit_code"/>
                    <field name="property_id"/>
                    <field name="unit_type"/>
                    <field name="floor"/>
                    <field name="market_rent"/>
                    <field name="status"/>
                    <field name="current_tenant_id"/>
                    <templates>
                        <t t-name="card">
                            <div class="d-flex justify-content-between">
                                <strong class="fs-6 text-dark"><field name="name"/></strong>
                                <span class="badge text-bg-light border"><field name="unit_code"/></span>
                            </div>
                            <div class="text-muted small mt-1">
                                <i class="fa fa-building-o me-1" title="Property"/> <field name="property_id"/> (<field name="floor"/>)
                            </div>
                            <div class="mt-2">
                                <span class="badge text-bg-secondary"><field name="unit_type"/></span>
                                <span class="text-primary fw-bold float-end"><field name="market_rent" widget="monetary"/></span>
                            </div>
                            <div class="mt-2 pt-2 border-top small text-muted" t-if="record.current_tenant_id.raw_value">
                                <i class="fa fa-user me-1" title="Tenant"/> <field name="current_tenant_id"/>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Unit Search View -->
        <record id="view_property_unit_search" model="ir.ui.view">
            <field name="name">property.unit.search</field>
            <field name="model">property.unit</field>
            <field name="arch" type="xml">
                <search string="Search Units">
                    <field name="name" string="Unit" filter_domain="['|', ('name', 'ilike', self), ('unit_code', 'ilike', self)]"/>
                    <field name="property_id"/>
                    <field name="current_tenant_id"/>
                    <filter string="Available Units" name="available" domain="[('status', '=', 'available')]"/>
                    <filter string="Occupied Units" name="occupied" domain="[('status', '=', 'occupied')]"/>
                    <filter string="Under Maintenance" name="maintenance" domain="[('status', '=', 'maintenance')]"/>
                    <separator/>
                    <filter string="Property" name="group_property" domain="[]" context="{'group_by': 'property_id'}"/>
                    <filter string="Status" name="group_status" domain="[]" context="{'group_by': 'status'}"/>
                    <filter string="Unit Type" name="group_type" domain="[]" context="{'group_by': 'unit_type'}"/>
                    <filter string="Floor" name="group_floor" domain="[]" context="{'group_by': 'floor'}"/>
                </search>
            </field>
        </record>

        <!-- All Units Action -->
        <record id="action_property_unit" model="ir.actions.act_window">
            <field name="name">Units</field>
            <field name="res_model">property.unit</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="search_view_id" ref="view_property_unit_search"/>
            <field name="context">{}</field>
        </record>

        <!-- Vacant Units Action -->
        <record id="action_property_unit_vacant" model="ir.actions.act_window">
            <field name="name">Vacant Units</field>
            <field name="res_model">property.unit</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="domain">[('status', '=', 'available')]</field>
            <field name="context">{'search_default_available': 1}</field>
        </record>

        <!-- Menu items -->
        <menuitem id="menu_property_units_list"
                  name="All Units"
                  parent="menu_property_properties_parent"
                  action="action_property_unit"
                  sequence="20"/>

        <menuitem id="menu_property_vacant_units_list"
                  name="Vacant Units"
                  parent="menu_property_properties_parent"
                  action="action_property_unit_vacant"
                  sequence="30"/>
    </data>
</odoo>
