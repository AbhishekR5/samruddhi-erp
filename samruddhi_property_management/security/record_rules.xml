        <!-- ================= PORTAL ISOLATION RULES ================= -->
        <!-- Landlord Portal Rules -->
        <record id="rule_portal_landlord_contract" model="ir.rule">
            <field name="name">Portal Landlord Contract Isolation</field>
            <field name="model_id" ref="model_property_landlord_contract"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">[('landlord_id', '=', user.partner_id.id)]</field>
        </record>

        <record id="rule_portal_landlord_payment" model="ir.rule">
