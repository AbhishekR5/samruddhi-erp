<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_profitability_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <h2 class="text-primary border-bottom pb-2">Property Net Income &amp; Profitability Statement</h2>
                            <div class="row mt-3 mb-4">
                                <div class="col-6">
                                    <h4 t-field="doc.name"/>
                                    <p class="mb-1"><strong>Code:</strong> <span t-field="doc.code"/></p>
                                    <p class="mb-1"><strong>Control:</strong> <span t-field="doc.control_type"/></p>
                                    <p class="mb-1"><strong>Occupancy:</strong> <span t-field="doc.occupied_units_count"/> / <span t-field="doc.total_units_count"/> Units (<span t-field="doc.occupancy_rate"/>%)</p>
                                </div>
                                <div class="col-6 text-end">
                                    <p class="mb-1"><strong>Report Date:</strong> <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d %B %Y')"/></p>
                                    <p class="mb-1"><strong>Operating Company:</strong> <span t-field="doc.company_id.name"/></p>
                                </div>
                            </div>

                            <h4 class="mt-4 mb-2">Monthly Economic Summary</h4>
                            <table class="table table-bordered w-75">
                                <thead class="table-light">
                                    <tr>
                                        <th>Component</th>
                                        <th class="text-end">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr class="table-success">
                                        <td><strong>(+) Tenant Rental Revenue</strong></td>
                                        <td class="text-end fw-bold"><span t-field="doc.total_monthly_revenue" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                    </tr>
                                    <tr class="table-danger">
                                        <td><strong>(-) Landlord Rental Cost</strong></td>
                                        <td class="text-end fw-bold"><span t-field="doc.total_monthly_cost" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                    </tr>
                                    <tr class="table-primary">
                                        <td><strong>(=) Net Operational Spread</strong></td>
                                        <td class="text-end fw-bold fs-5"><span t-field="doc.monthly_net_income" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                    </tr>
                                </tbody>
                            </table>

                            <h4 class="mt-4 mb-2">Active Tenant Contract Contributions</h4>
                            <table class="table table-sm table-striped border">
                                <thead class="table-light">
                                    <tr>
                                        <th>Contract</th>
                                        <th>Unit</th>
                                        <th>Tenant</th>
                                        <th>Type</th>
                                        <th class="text-end">Monthly Rent</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="doc.tenant_contract_ids.filtered(lambda c: c.state == 'active')" t-as="tc">
                                        <td><span t-field="tc.name"/></td>
                                        <td><span t-field="tc.unit_id.name"/></td>
                                        <td><span t-field="tc.tenant_id.name"/></td>
                                        <td><span t-field="tc.contract_type"/></td>
                                        <td class="text-end"><span t-field="tc.monthly_rent" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>
